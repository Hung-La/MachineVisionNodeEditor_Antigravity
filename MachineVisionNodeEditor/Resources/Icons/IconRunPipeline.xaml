    <DrawingImage x:Key="IconRunPipeline">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Background rounded badge (YouTube style rounded box) in light green -->
                <GeometryDrawing Geometry="M 4,5 C 4,3 5.5,1.5 7.5,1.5 L 24.5,1.5 C 26.5,1.5 28,3 28,5 L 28,19 C 28,21 26.5,22.5 24.5,22.5 L 7.5,22.5 C 5.5,22.5 4,21 4,19 Z">
