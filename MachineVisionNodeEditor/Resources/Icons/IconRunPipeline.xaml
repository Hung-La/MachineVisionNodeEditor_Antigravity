                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A6E3A1" Offset="0"/>
                            <GradientStop Color="#66BB6A" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- YouTube-style Play Triangle with rounded corners in white -->
                <GeometryDrawing Brush="#FFFFFF" Geometry="M 12.5,7.2 C 12.0,6.9 11.5,7.2 11.5,7.8 L 11.5,16.2 C 11.5,16.8 12.0,17.1 12.5,16.8 L 19.5,12.5 C 20.0,12.2 20.0,11.8 19.5,11.5 Z"/>

