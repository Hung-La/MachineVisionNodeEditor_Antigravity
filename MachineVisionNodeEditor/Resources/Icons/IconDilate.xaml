<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="IconDilate">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M2,3 L14,3 L14,13 L2,13 Z"/>

                <!-- Background -->
                <GeometryDrawing
                    Brush="#FF212121"
                    Geometry="M3,4 L13,4 L13,12 L3,12 Z"/>

                <!-- Expanded/Dilated Shape (Blue) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsSecond}"
                    Geometry="M5,5 H11 V11 H5 Z"/>

                <!-- Original Shape (semi-transparent gray/white overlay) -->
                <GeometryDrawing
                    Brush="#60FFFFFF"
                    Geometry="M7,7 H9 V9 H7 Z"/>

                <!-- Outward arrows pointing from original to dilated boundary (Orange/Red) -->
                <!-- Top arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M8,5.2 L7.2,6.5 H8.8 Z"/>
                <!-- Bottom arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M8,10.8 L7.2,9.5 H8.8 Z"/>
                <!-- Left arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M5.2,8 L6.5,7.2 V8.8 Z"/>
                <!-- Right arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M10.8,8 L9.5,7.2 V8.8 Z"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
