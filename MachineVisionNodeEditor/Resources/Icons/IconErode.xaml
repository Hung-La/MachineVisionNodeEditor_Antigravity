<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="IconErode">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M2,3 L14,3 L14,13 L2,13 Z"/>

                <!-- Background -->
                <GeometryDrawing
                    Brush="#FF212121"
                    Geometry="M3,4 L13,4 L13,12 L3,12 Z"/>

                <!-- Original Shape (semi-transparent gray/white) -->
                <GeometryDrawing
                    Brush="#60FFFFFF"
                    Geometry="M5,5 H11 V11 H5 Z"/>

                <!-- Eroded Shape (Blue) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsSecond}"
                    Geometry="M7,7 H9 V9 H7 Z"/>

                <!-- Inward arrows pointing from original to eroded boundary (Orange/Red) -->
                <!-- Top arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M8,6.5 L7.2,5.2 H8.8 Z"/>
                <!-- Bottom arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M8,9.5 L7.2,10.8 H8.8 Z"/>
                <!-- Left arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M6.5,8 L5.2,7.2 V8.8 Z"/>
                <!-- Right arrow -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M9.5,8 L10.8,7.2 V8.8 Z"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
