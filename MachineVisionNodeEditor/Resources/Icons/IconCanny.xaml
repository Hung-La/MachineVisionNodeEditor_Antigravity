<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="IconCanny">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M2,3 L14,3 L14,13 L2,13 Z"/>

                <!-- Background -->
                <GeometryDrawing
                    Brush="#FF212121"
                    Geometry="M3,4 L13,4 L13,12 L3,12 Z"/>

                <!-- Canny Edge Lines -->
                <GeometryDrawing
                    Brush="#FF00E676"
                    Geometry="M4,10 L7,6 L9,9 L12,4"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
