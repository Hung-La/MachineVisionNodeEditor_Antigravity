<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 📏 Icon Hough Lines P: Probabilistic Line Segment Detection with Endpoint Keypoints & Rho/Theta vectors -->
    <DrawingImage x:Key="IconHoughLinesP">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Canvas Outer Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M1.5,1.5 L14.5,1.5 L14.5,14.5 L1.5,14.5 Z"/>

                <!-- Dark Space Canvas -->
                <GeometryDrawing
                    Brush="#FF151B22"
                    Geometry="M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z"/>

                <!-- Coordinate Grid / Hough Space Axes (Subtle Cyan) -->
                <GeometryDrawing
                    Brush="#3300E5FF"
                    Geometry="M3,13 L13,13 M3,3 L3,13 M6,3 L6,13 M9,3 L9,13 M12,3 L12,13 M3,6 L13,6 M3,9 L13,9"/>

                <!-- Hough Normal Vector (Rho ray from origin, Purple/Magenta) -->
                <GeometryDrawing
                    Brush="#88E040FB"
                    Geometry="M3,13 L6.5,8"/>

                <!-- Detected Primary Line Segment 1 (Vibrant Red-Orange with thickness) -->
                <GeometryDrawing
                    Brush="#FFFF3D00"
                    Geometry="M3.5,12.5 L12.5,3.5 L13.2,4.2 L4.2,13.2 Z"/>

                <!-- Detected Secondary Line Segment 2 (Bright Neon Green) -->
                <GeometryDrawing
                    Brush="#FF00E676"
                    Geometry="M4,4.5 L11,9.5 L10.6,10.2 L3.6,5.2 Z"/>

                <!-- Detected Line Segment 3 (Yellow horizontal segment) -->
                <GeometryDrawing
                    Brush="#FFFFD600"
                    Geometry="M7,11.5 L12.5,11.5 L12.5,12.3 L7,12.3 Z"/>

                <!-- Line Segment 1 Endpoints (P1 & P2 Glowing Cyan Nodes) -->
                <GeometryDrawing
                    Brush="#FF00E5FF"
                    Geometry="M3.8,12.8 A1.1,1.1 0 1 1 3.7,12.8 Z M12.8,3.8 A1.1,1.1 0 1 1 12.7,3.8 Z"/>

                <!-- Line Segment 2 Endpoints (Glowing Green Nodes) -->
                <GeometryDrawing
                    Brush="#FF76FF03"
                    Geometry="M3.8,4.8 A0.9,0.9 0 1 1 3.7,4.8 Z M10.8,9.8 A0.9,0.9 0 1 1 10.7,9.8 Z"/>

                <!-- Angle Theta indicator arc -->
                <GeometryDrawing
                    Brush="#FFFFAB00"
                    Geometry="M5,13 A2,2 0 0 1 4.5,11.5"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
