<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="IconMorphologyEx">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M2,3 L14,3 L14,13 L2,13 Z"/>

                <!-- Background -->
                <GeometryDrawing
                    Brush="#FF212121"
                    Geometry="M3,4 L13,4 L13,12 L3,12 Z"/>

                <!-- Left Shape (Square) (Blue) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsSecond}"
                    Geometry="M4,8 H6 V10 H4 Z"/>

                <!-- Noise dot (Blue) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsSecond}"
                    Geometry="M4,5 H5 V6 H4 Z"/>

                <!-- Structuring Element (Orange) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsFourth}"
                    Geometry="M6.5,5.5 A0.6,0.6 0 1 1 6.4,5.5 Z"/>

                <!-- Transform Arrow (Gray) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M7.5,7.5 H8.8 V6.8 L10.2,8 L8.8,9.2 V8.5 H7.5 Z"/>

                <!-- Right Shape (Cleaned Square) (Blue) -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsSecond}"
                    Geometry="M11,8 H13 V10 H11 Z"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
