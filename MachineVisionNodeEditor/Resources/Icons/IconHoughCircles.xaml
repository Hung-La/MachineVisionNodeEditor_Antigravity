<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ⭕ Icon Hough Circles: Hough Circle Transform with circular contour rings, center crosshairs & radius vectors -->
    <DrawingImage x:Key="IconHoughCircles">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Canvas Outer Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M1.5,1.5 L14.5,1.5 L14.5,14.5 L1.5,14.5 Z"/>

                <!-- Dark Space Canvas -->
                <GeometryDrawing
                    Brush="#FF151B22"
                    Geometry="M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z"/>

                <!-- Primary Detected Circle (Vibrant Cyan Ring) -->
                <GeometryDrawing
                    Brush="#FF00E5FF"
                    Geometry="M8,3.2 C10.65,3.2 12.8,5.35 12.8,8 C12.8,10.65 10.65,12.8 8,12.8 C5.35,12.8 3.2,10.65 3.2,8 C3.2,5.35 5.35,3.2 8,3.2 Z M8,4.2 C5.9,4.2 4.2,5.9 4.2,8 C4.2,10.1 5.9,11.8 8,11.8 C10.1,11.8 11.8,10.1 11.8,8 C11.8,5.9 10.1,4.2 8,4.2 Z"/>

                <!-- Secondary Small Circle (Amber / Orange Ring) -->
                <GeometryDrawing
                    Brush="#FFFF6D00"
                    Geometry="M11.5,4.5 C12.6,4.5 13.5,5.4 13.5,6.5 C13.5,7.6 12.6,8.5 11.5,8.5 C10.4,8.5 9.5,7.6 9.5,6.5 C9.5,5.4 10.4,4.5 11.5,4.5 Z M11.5,5.3 C10.8,5.3 10.3,5.8 10.3,6.5 C10.3,7.2 10.8,7.7 11.5,7.7 C12.2,7.7 12.7,7.2 12.7,6.5 C12.7,5.8 12.2,5.3 11.5,5.3 Z"/>

                <!-- Radius Measurement Vector Arrow (Center to Perimeter, Yellow) -->
                <GeometryDrawing
                    Brush="#FFFFEA00"
                    Geometry="M8,8 L11.4,5.6 L11.8,6.2 L8.4,8.6 Z"/>

                <!-- Center Point Crosshair for Primary Circle (Neon Green / Red) -->
                <GeometryDrawing
                    Brush="#FF00E676"
                    Geometry="M8,6 L8,10 M6,8 L10,8"/>

                <!-- Center Crosshair Center Dot -->
                <GeometryDrawing
                    Brush="#FFFF1744"
                    Geometry="M8,8 A0.9,0.9 0 1 1 7.9,8 Z"/>

                <!-- Radius Perimeter Endpoint Indicator Dot -->
                <GeometryDrawing
                    Brush="#FFFFD600"
                    Geometry="M11.5,5.7 A0.8,0.8 0 1 1 11.4,5.7 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
