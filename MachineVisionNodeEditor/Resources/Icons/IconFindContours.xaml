<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="IconFindContours">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Frame -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M2,2 L14,2 L14,14 L2,14 Z"/>

                <!-- Background -->
                <GeometryDrawing
                    Brush="#FF212121"
                    Geometry="M3,3 L13,3 L13,13 L3,13 Z"/>

                <!-- Contour loop vector drawing -->
                <GeometryDrawing
                    Brush="#FF00E676"
                    Geometry="M4,8 C4,5 7,4 9,4 C11,4 12,6 12,8 C12,11 10,12 8,12 C5,12 4,10 4,8 Z M6,8 C6,9 7,10 8,10 C9,10 10,9 10,8 C10,7 9,6 8,6 C7,6 6,7 6,8 Z"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
