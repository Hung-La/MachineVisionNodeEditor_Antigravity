<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 🔍 Icon Find Contours: Detecting object contour boundaries & vertices -->
    <DrawingImage x:Key="IconFindContours">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Outer Frame / Image Sensor -->
                <GeometryDrawing
                    Brush="{DynamicResource ColorIconsMain}"
                    Geometry="M1.5,1.5 L14.5,1.5 L14.5,14.5 L1.5,14.5 Z"/>

                <!-- Dark Sensor Surface -->
                <GeometryDrawing
                    Brush="#FF1E262C"
                    Geometry="M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z"/>

                <!-- Detected Binary Object Silhouette (translucent fill) -->
                <GeometryDrawing
                    Brush="#3300E676"
                    Geometry="M4.5,7 C4.5,4.5 7,3.5 10,4.5 C12,5 12.5,8 11.5,10.5 C10.5,12 7,12.5 5,11 C4,10 4.5,8.5 4.5,7 Z"/>

                <!-- Bright Neon Green Contour Outline Stroke -->
                <GeometryDrawing
                    Brush="#FF00E676"
                    Geometry="M4.5,7 C4.5,4.5 7,3.5 10,4.5 C12,5 12.5,8 11.5,10.5 C10.5,12 7,12.5 5,11 C4,10 4.5,8.5 4.5,7 Z M4.5,7.8 C4.8,9 5.2,10.2 6,10.8 C7.5,11.8 10,11.2 10.8,10 C11.5,8 11,5.8 9.5,5.3 C7.5,4.5 5.5,5.2 5.5,7 Z"/>

                <!-- Vertex Detection Anchor Points (Cyan / Yellow dots) -->
                <GeometryDrawing
                    Brush="#FF00E5FF"
                    Geometry="M4.5,7 A0.9,0.9 0 1 1 4.4,7 Z M10,4.5 A0.9,0.9 0 1 1 9.9,4.5 Z M11.5,10.5 A0.9,0.9 0 1 1 11.4,10.5 Z M5,11 A0.9,0.9 0 1 1 4.9,11 Z"/>

                <!-- Scanner Crosshair / Search Reticle -->
                <GeometryDrawing
                    Brush="#FFFFD600"
                    Geometry="M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
