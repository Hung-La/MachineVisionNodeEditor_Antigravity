
    <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
                    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/MaterialDesign/MainResource.xaml"/>
        <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared Resources (Style/Brushes) for parameters -->
    <Style x:Key="SettingCardStyle" TargetType="{x:Type materialDesign:Card}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="UniformCornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
    </Style>

    <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SettingButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SettingComboStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,4,0,12"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SettingSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Margin" Value="0,4,0,12"/>
    </Style>

    <Style x:Key="SettingCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,8,0,12"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 1. Image Import -->
    <DataTemplate DataType="{x:Type ViewModel:ImageImport_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Image Path"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Style="{StaticResource SettingTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Select an image file..."
                             Text="{Binding NodePropertyModel.FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" 
                            Style="{StaticResource SettingButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Color Mode"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Color Mode"
                          ItemsSource="{Binding NodePropertyModel.ColorModes}"  
                          SelectedItem="{Binding NodePropertyModel.SelectedMode}"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 2. Convert Color -->
    <DataTemplate DataType="{x:Type ViewModel:ConvertColor_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Color Mode"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Conversion Code"
                          ItemsSource="{Binding NodePropertyModel.ColorCodes}"  
                          SelectedItem="{Binding NodePropertyModel.SelectedCode}"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 3. Threshold -->
    <DataTemplate DataType="{x:Type ViewModel:Threshold_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Threshold Type"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Threshold Type"
                          ItemsSource="{Binding NodePropertyModel.AvailableTypes}"
                          SelectedItem="{Binding NodePropertyModel.SelectedType}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Thresh, StringFormat='Threshold Value: {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0" Maximum="255" Value="{Binding NodePropertyModel.Thresh}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.MaxVal, StringFormat='Max Value: {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0" Maximum="255" Value="{Binding NodePropertyModel.MaxVal}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 4. Gaussian Blur -->
    <DataTemplate DataType="{x:Type ViewModel:GaussianBlur_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.KSize, StringFormat='Kernel Size (Odd): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="31" Value="{Binding NodePropertyModel.KSize}" 
                        TickFrequency="2" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.SigmaX, StringFormat='Sigma X: {0:F1}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0" Maximum="20" Value="{Binding NodePropertyModel.SigmaX}" 
                        TickFrequency="0.5" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 5. Median Blur -->
    <DataTemplate DataType="{x:Type ViewModel:MedianBlur_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.KSize, StringFormat='Kernel Size (Odd): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="31" Value="{Binding NodePropertyModel.KSize}" 
                        TickFrequency="2" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 6. Bilateral Filter -->
    <DataTemplate DataType="{x:Type ViewModel:BilateralFilter_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.D, StringFormat='Diameter (d): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="30" Value="{Binding NodePropertyModel.D}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.SigmaColor, StringFormat='Sigma Color: {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="200" Value="{Binding NodePropertyModel.SigmaColor}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.SigmaSpace, StringFormat='Sigma Space: {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="200" Value="{Binding NodePropertyModel.SigmaSpace}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 7. Canny -->
    <DataTemplate DataType="{x:Type ViewModel:Canny_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Threshold1, StringFormat='Threshold 1 (Min): {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0" Maximum="500" Value="{Binding NodePropertyModel.Threshold1}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Threshold2, StringFormat='Threshold 2 (Max): {0:F0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0" Maximum="500" Value="{Binding NodePropertyModel.Threshold2}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Aperture Size"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Aperture Size"
                          ItemsSource="{Binding NodePropertyModel.ApertureSizes}"
                          SelectedItem="{Binding NodePropertyModel.ApertureSize}"/>

                <CheckBox Style="{StaticResource SettingCheckBoxStyle}"
                          Content="Use L2 Gradient" 
                          IsChecked="{Binding NodePropertyModel.L2Gradient}"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 8. Erode -->
    <DataTemplate DataType="{x:Type ViewModel:Erode_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Element Shape"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Shape"
                          ItemsSource="{Binding NodePropertyModel.Shapes}"
                          SelectedItem="{Binding NodePropertyModel.Shape}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.KSize, StringFormat='Kernel Size (Odd): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="31" Value="{Binding NodePropertyModel.KSize}" 
                        TickFrequency="2" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Iterations, StringFormat='Iterations: {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="10" Value="{Binding NodePropertyModel.Iterations}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 9. Dilate -->
    <DataTemplate DataType="{x:Type ViewModel:Dilate_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Element Shape"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Shape"
                          ItemsSource="{Binding NodePropertyModel.Shapes}"
                          SelectedItem="{Binding NodePropertyModel.Shape}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.KSize, StringFormat='Kernel Size (Odd): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="31" Value="{Binding NodePropertyModel.KSize}" 
                        TickFrequency="2" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Iterations, StringFormat='Iterations: {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="10" Value="{Binding NodePropertyModel.Iterations}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 10. MorphologyEx -->
    <DataTemplate DataType="{x:Type ViewModel:MorphologyEx_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Morphology Operation"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Operation"
                          ItemsSource="{Binding NodePropertyModel.Operations}"
                          SelectedItem="{Binding NodePropertyModel.Operation}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Element Shape"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Shape"
                          ItemsSource="{Binding NodePropertyModel.Shapes}"
                          SelectedItem="{Binding NodePropertyModel.Shape}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.KSize, StringFormat='Kernel Size (Odd): {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="31" Value="{Binding NodePropertyModel.KSize}" 
                        TickFrequency="2" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Iterations, StringFormat='Iterations: {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="10" Value="{Binding NodePropertyModel.Iterations}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 11. Image Rotate -->
    <DataTemplate DataType="{x:Type ViewModel:ImageRotate_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Angle, StringFormat='Angle (°): {0:F1}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="-360" Maximum="360" Value="{Binding NodePropertyModel.Angle}" 
                        TickFrequency="15" IsSnapToTickEnabled="False"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Scale, StringFormat='Scale: {0:F2}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="0.1" Maximum="5.0" Value="{Binding NodePropertyModel.Scale}" 
                        TickFrequency="0.1" IsSnapToTickEnabled="False"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Interpolation"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Interpolation"
                          ItemsSource="{Binding NodePropertyModel.Interpolations}"
                          SelectedItem="{Binding NodePropertyModel.Interpolation}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Border Mode"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Border Mode"
                          ItemsSource="{Binding NodePropertyModel.BorderModes}"
                          SelectedItem="{Binding NodePropertyModel.BorderMode}"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 12. Image Resize -->
    <DataTemplate DataType="{x:Type ViewModel:ImageResize_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <CheckBox Style="{StaticResource SettingCheckBoxStyle}"
                          Content="Resize by Scale Factor (fx, fy)" 
                          IsChecked="{Binding NodePropertyModel.UseScaleFactor}"/>

                <!-- Absolute Size Controls -->
                <StackPanel Visibility="{Binding NodePropertyModel.UseScaleFactor, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Target Width"/>
                    <TextBox Style="{StaticResource SettingTextBoxStyle}"
                             Margin="0,0,0,12"
                             Text="{Binding NodePropertyModel.TargetWidth, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Target Height"/>
                    <TextBox Style="{StaticResource SettingTextBoxStyle}"
                             Margin="0,0,0,12"
                             Text="{Binding NodePropertyModel.TargetHeight, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Scale Factor Controls -->
                <StackPanel Visibility="{Binding NodePropertyModel.UseScaleFactor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource SettingLabelStyle}" 
                               Text="{Binding NodePropertyModel.ScaleX, StringFormat='Scale X (fx): {0:F2}'}"/>
                    <Slider Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0.05" Maximum="10.0" Value="{Binding NodePropertyModel.ScaleX}" 
                            TickFrequency="0.1" IsSnapToTickEnabled="False"/>

                    <TextBlock Style="{StaticResource SettingLabelStyle}" 
                               Text="{Binding NodePropertyModel.ScaleY, StringFormat='Scale Y (fy): {0:F2}'}"/>
                    <Slider Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0.05" Maximum="10.0" Value="{Binding NodePropertyModel.ScaleY}" 
                            TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Interpolation"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Interpolation"
                          ItemsSource="{Binding NodePropertyModel.Interpolations}"
                          SelectedItem="{Binding NodePropertyModel.Interpolation}"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 13. Find Contours -->
    <DataTemplate DataType="{x:Type ViewModel:FindContours_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Retrieval Mode"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Retrieval Mode"
                          ItemsSource="{Binding NodePropertyModel.Modes}"
                          SelectedItem="{Binding NodePropertyModel.Mode}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Approximation Method"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Approximation Method"
                          ItemsSource="{Binding NodePropertyModel.Methods}"
                          SelectedItem="{Binding NodePropertyModel.Method}"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Thickness, StringFormat='Line Thickness: {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="10" Value="{Binding NodePropertyModel.Thickness}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.ContourCount, StringFormat='Contours Found: {0}'}" 
                           FontWeight="Bold"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <!-- 14. Draw Contours -->
    <DataTemplate DataType="{x:Type ViewModel:DrawContours_NodeViewModel}">
        <materialDesign:Card Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <!-- Area Min -->
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.AreaMin, StringFormat='Min Area (AreaMin): {0:F0}'}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0" Maximum="{Binding NodePropertyModel.AreaMax}" Value="{Binding NodePropertyModel.AreaMin}" 
                            TickFrequency="50" IsSnapToTickEnabled="False"/>
                    <TextBox Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" 
                             Text="{Binding NodePropertyModel.AreaMin, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="8,0,0,0"/>
                </Grid>

                <!-- Area Max -->
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.AreaMax, StringFormat='Max Area (AreaMax): {0:F0}'}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0" Maximum="8000" Value="{Binding NodePropertyModel.AreaMax}" 
                            TickFrequency="100" IsSnapToTickEnabled="False"/>
                    <TextBox Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" 
                             Text="{Binding NodePropertyModel.AreaMax, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="8,0,0,0"/>
                </Grid>

                <!-- Contour Color -->
                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Contour Color"/>
                <ComboBox Style="{StaticResource SettingComboStyle}"
                          materialDesign:HintAssist.Hint="Select Contour Color"
                          ItemsSource="{Binding NodePropertyModel.AvailableColors}"
                          SelectedItem="{Binding NodePropertyModel.SelectedColor}"/>

                <!-- Custom RGB Sliders -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource SettingLabelStyle}" 
                               Text="{Binding NodePropertyModel.CustomR, StringFormat='Red (R): {0}'}"/>
                    <Slider Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0" Maximum="255" Value="{Binding NodePropertyModel.CustomR}" 
                            TickFrequency="1" IsSnapToTickEnabled="True"/>

                    <TextBlock Style="{StaticResource SettingLabelStyle}" 
                               Text="{Binding NodePropertyModel.CustomG, StringFormat='Green (G): {0}'}"/>
                    <Slider Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0" Maximum="255" Value="{Binding NodePropertyModel.CustomG}" 
                            TickFrequency="1" IsSnapToTickEnabled="True"/>

                    <TextBlock Style="{StaticResource SettingLabelStyle}" 
                               Text="{Binding NodePropertyModel.CustomB, StringFormat='Blue (B): {0}'}"/>
                    <Slider Style="{StaticResource SettingSliderStyle}" 
                            Minimum="0" Maximum="255" Value="{Binding NodePropertyModel.CustomB}" 
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <!-- Thickness -->
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.Thickness, StringFormat='Line Thickness: {0}'}"/>
                <Slider Style="{StaticResource SettingSliderStyle}" 
                        Minimum="1" Maximum="10" Value="{Binding NodePropertyModel.Thickness}" 
                        TickFrequency="1" IsSnapToTickEnabled="True"/>

                <!-- Contours Count Status -->
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.DrawnContours, StringFormat='Drawn Contours: {0}'}" 
                           FontWeight="Bold"/>
                <TextBlock Style="{StaticResource SettingLabelStyle}" 
                           Text="{Binding NodePropertyModel.TotalContours, StringFormat='Total Detected Contours: {0}'}" 
                           FontSize="11" Foreground="Gray"/>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

</ResourceDictionary>
