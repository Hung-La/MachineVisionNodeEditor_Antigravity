<UserControl x:Class="MachineVisionNodeEditor.Views.Nodes.Node_ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.Nodes"
             xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!--<UserControl.DataContext>
        <ViewModel:Node_ConnectionViewModel></ViewModel:Node_ConnectionViewModel>
    </UserControl.DataContext>-->

    <Path
        x:Name="Connector"
        StrokeThickness="3"
        MouseDown="Connector_MouseDown">

        <!--<Path.Style>
            <Style TargetType="Path">
                <Setter Property="Stroke" Value="MediumPurple"/>
                <Setter Property="StrokeThickness" Value="3"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ConnectionModel.IsSelected}" Value="True">
                        <Setter Property="Stroke" Value="DodgerBlue"/>
                        <Setter Property="StrokeThickness" Value="5"/>
                    </DataTrigger>
                </Style.Triggers>

            </Style>
        </Path.Style>-->

        <Path.Style>
            <Style TargetType="Path">
                <!-- Màu mặc định -->
                <Setter Property="Stroke"
                    Value="{DynamicResource ConnectionColor}" />
                <Setter Property="StrokeThickness"
                    Value="3"/>
                <Style.Triggers>
                    <!-- Khi được chọn -->
                    <DataTrigger Binding="{Binding ConnectionModel.IsSelected}" Value="True">
                        <Setter Property="Stroke" Value="DodgerBlue"/>
                        <Setter Property="StrokeThickness" Value="10"/>
                    </DataTrigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Cursor" Value="Hand"></Setter>
                        <Setter Property="Opacity" Value="0.7"></Setter>
                    </Trigger>
                </Style.Triggers>

            </Style>
        </Path.Style>

        <Path.Data>
            <PathGeometry>
                <PathFigure StartPoint="{Binding ConnectionModel.Start}">
                    <BezierSegment
                        Point1="{Binding ConnectionModel.Control1}"
                        Point2="{Binding ConnectionModel.Control2}"
                        Point3="{Binding ConnectionModel.End}"/>
                </PathFigure>
            </PathGeometry>
        </Path.Data>
        
    </Path>
</UserControl>
