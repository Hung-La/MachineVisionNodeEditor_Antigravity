<local:NodeControl 
             x:Class="MachineVisionNodeEditor.Views.Nodes.DrawOnImage_NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.Nodes" 
             xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=ViewModel:Node_NodeViewModel}"
             d:DesignHeight="150" d:DesignWidth="160"
             Loaded="NodeControl_Loaded"
             MinWidth="125" MaxWidth="225"
             Height="Auto">
    <local:NodeControl.Resources>
        <Style x:Key="PortStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill"   Value="#37474F"/>
            <Setter Property="Stroke" Value="#00BCD4"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="#00BCD4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:NodeControl.Resources>

    <local:NodeControl.Effect>
        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
    </local:NodeControl.Effect>

    <Grid>
        <Border Background="{DynamicResource NodeBackground}"
        CornerRadius="8"
        Padding="0,0,0,12"
        MouseDown="Header_MouseDown"
        MouseMove="Header_MouseMove"
        MouseUp="Header_MouseUp">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="1.5"></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NodeModel.ExecutionState}" Value="Success">
                            <Setter Property="BorderBrush" Value="LightGreen"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NodeModel.ExecutionState}" Value="Failed">
                            <Setter Property="BorderBrush" Value="#FF5252"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NodeModel.HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="#FF5252"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NodeModel.IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="Fuchsia"/>
                            <Setter Property="BorderThickness" Value="2"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel x:Name="StackPanel_Text">
                <Border Background="#00BCD4"
                CornerRadius="6,6,0,0"
                Padding="10,6"
                Cursor="SizeAll">
                    <TextBlock 
                    x:Name="TextBlock_Header"
                    Text="{Binding NodeModel.Title}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="13"
                    FontFamily="Consolas"/>
                </Border>

                <Grid x:Name="Grid_Node" Margin="0,10,0,0">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <Style TargetType="TextBox" x:Key="TextBoxStyle" BasedOn="{StaticResource MaterialDesignTextBoxBase}">
                                <EventSetter Event="KeyDown" Handler="TextBox_KeyDown"/>
                            </Style>
                        </ResourceDictionary>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                               x:Name="InputPortsControl"
                               ItemsSource="{Binding NodeModel.InputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:Node_PortView
                                    Margin="-10,2,0,2"
                                    PortMouseUp="Port_PortMouseUp"
                                    ToolTip="Input Port"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Grid.Column="1"
                       Style="{StaticResource TextBoxStyle}"
                       Text="{Binding NodePropertyModel.Name, UpdateSourceTrigger=PropertyChanged}"
                       Foreground="{DynamicResource NodeText}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    </TextBox>

                    <ItemsControl Grid.Column="2"
                               x:Name="OutputPortsControl"
                               ItemsSource="{Binding NodeModel.OutputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:Node_PortView
                                    Margin="0,2,-10,2"
                                    PortMouseUp="Port_PortMouseUp"
                                    ToolTip="Output Port"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</local:NodeControl>
