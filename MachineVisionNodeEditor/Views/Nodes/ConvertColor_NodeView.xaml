<local:NodeControl x:Class="MachineVisionNodeEditor.Views.Nodes.ConvertColor_NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.Nodes"
             xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
             d:DataContext="{d:DesignInstance Type=ViewModel:ConvertColor_NodeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="160">

    <local:NodeControl.Resources>
            <!--<ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source=""></ResourceDictionary>
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>-->

        <!-- Style cho port (hình tròn nhỏ) -->
        <Style x:Key="PortStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill"   Value="#37474F"/>
            <Setter Property="Stroke" Value="#00BCD4"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="#00BCD4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </local:NodeControl.Resources>

    <!-- Shadow effect cho node -->
    <local:NodeControl.Effect>
        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
    </local:NodeControl.Effect>

    <!--<UserControl.DataContext>
        <ViewModel:Node_NodeViewModel></ViewModel:Node_NodeViewModel>
    </UserControl.DataContext>-->

    <Grid>
        <!-- Body của node -->
        <Border Background="{DynamicResource NodeBackground}"
            CornerRadius="8"
            Padding="0,0,0,12"
            MouseDown="Header_MouseDown"
            MouseMove="Header_MouseMove"
            MouseUp="Header_MouseUp">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="1.5"></Setter>
                    <Style.Triggers>

                        <!-- Đã thực thi thành công -> Xanh lá -->
                        <DataTrigger Binding="{Binding NodeModel.ExecutionState}" Value="Success">
                            <Setter Property="BorderBrush" Value="LightGreen"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>

                        <!-- Thực thi thất bại / lỗi -> Đỏ -->
                        <DataTrigger Binding="{Binding NodeModel.ExecutionState}" Value="Failed">
                            <Setter Property="BorderBrush" Value="#FF5252"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>

                        <!-- Chưa thực thi / HasError -> Đỏ -->
                        <DataTrigger Binding="{Binding NodeModel.HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="#FF5252"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>

                        <!-- Đang được chọn -->
                        <DataTrigger Binding="{Binding NodeModel.IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="MediumPurple"/>
                            <Setter Property="BorderThickness" Value="3.5"></Setter>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel 
            x:Name="StackPanel_Text">
                <!-- Header -->
                <Border Background="#00BCD4"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    Cursor="SizeAll">
                    <TextBlock 
                        x:Name="TextBlock_Header"
                        Text="{Binding NodeModel.Title}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="13"
                        FontFamily="Consolas"/>
                </Border>

                <!-- Content -->
                <Grid 
                    x:Name="Grid_Node"
                    Margin="0,10,0,0">

                    <Grid.Resources>

                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="/Resources/MaterialDesign/MainResource.xaml"></ResourceDictionary>
                            </ResourceDictionary.MergedDictionaries>

                            <Style TargetType="TextBox" x:Key="TextBoxStyle" BasedOn="{StaticResource MaterialDesignTextBoxBase}">
                                <EventSetter
                                    Event="KeyDown"
                                    Handler="TextBox_KeyDown">
                                </EventSetter>
                            </Style>

                        </ResourceDictionary>

                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- INPUT PORTS (left, dynamic) -->
                    <ItemsControl Grid.Column="0"
                              x:Name="InputPortsControl"
                              ItemsSource="{Binding NodeModel.InputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- DataContext here IS the PortModel -->
                                <local:Node_PortView
                            Margin="-10,2,0,2"
                            PortMouseUp="Port_PortMouseUp"
                            ToolTip="Input Port"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Label -->
                    <TextBox Grid.Column="1"
                           Style="{StaticResource TextBoxStyle}"
                           Text="{Binding NodePropertyModel.Name, UpdateSourceTrigger=PropertyChanged}"
                           Foreground="{DynamicResource NodeText}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    </TextBox>

                    <!-- OUTPUT PORTS (right, dynamic) -->
                    <ItemsControl Grid.Column="2"
                              x:Name="OutputPortsControl"
                              ItemsSource="{Binding NodeModel.OutputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:Node_PortView
                                Margin="0,2,-10,2"
                                PortMouseUp="Port_PortMouseUp"
                                ToolTip="Output Port"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</local:NodeControl>
