<UserControl x:Class="MachineVisionNodeEditor.Views.ImageViewer.ImageViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.ImageViewer"
             mc:Ignorable="d" 
             Background="{DynamicResource WindowBackground}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="ViewerControl">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/WindowStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Canvas does not constrain its children size during measure/arrange -->
        <Canvas x:Name="ViewportCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border
                x:Name="ImageBorder"
                BorderThickness="1.5"
                BorderBrush="DimGray"
                ClipToBounds="True">

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform
                            x:Name="scale"/>
                        <TranslateTransform
                            x:Name="translate"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Canvas
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Width="{Binding NodePropertyModel.Width}"
                    Height="{Binding NodePropertyModel.Height}"
                    RenderTransformOrigin="0,0"
                    MouseDown="Image_MouseDown"
                    MouseMove="Image_MouseMove"
                    MouseUp="Image_MouseUp"
                    MouseWheel="Image_MouseWheel"
                    ClipToBounds="True">

                    <Image
                        Panel.ZIndex="0"
                        x:Name="Image"
                        Source="{Binding ElementName=ViewerControl, Path=ViewImage, 
                        Converter={StaticResource MatToBitmapSourceConverter}}"
                        Stretch="None">

                    </Image>

                    <Canvas 
                        x:Name="OverlayCanvas"
                        Width="{Binding ElementName=ViewerControl, Path=ViewImage,
                        Converter={StaticResource ResolutionConverter},
                        ConverterParameter=Width}"
                        
                        Height="{Binding ElementName=ViewerControl, Path=ViewImage,
                        Converter={StaticResource ResolutionConverter},
                        ConverterParameter=Height}"

                        Panel.ZIndex="2">
                        
                        <Canvas.Background>
                            <DrawingBrush 
                                        TileMode="Tile"
                                        Viewport="0,0,100,100"
                                        ViewportUnits="Absolute">

                                <DrawingBrush.Drawing>
                                    <DrawingGroup>

                                        <!-- 🎨 MÀU NỀN -->
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,100,100"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- 🔲 GRID -->
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Pen>
                                                <Pen 
                                                    Brush="{Binding ElementName=ViewerControl, Path=PenBrush}"  
                                                    Thickness="{Binding ElementName=ViewerControl,Path=PenThickness}">
                                                    <Pen.DashStyle>
                                                        <DashStyle Dashes="1.5"/>
                                                    </Pen.DashStyle>
                                                </Pen>
                                            </GeometryDrawing.Pen>

                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <!-- dọc -->
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                                                    <!-- ngang -->
                                                    <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                    </DrawingGroup>
                                </DrawingBrush.Drawing>

                            </DrawingBrush>
                        </Canvas.Background>
                    </Canvas>

                </Canvas>

            </Border>
        </Canvas>
    </Grid>
    
</UserControl>
