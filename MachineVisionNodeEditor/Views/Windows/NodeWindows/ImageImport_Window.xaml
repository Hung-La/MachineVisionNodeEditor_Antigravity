<Window x:Class="MachineVisionNodeEditor.Views.Windows.NodeWindows.ImageImport_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.Windows.NodeWindows"
        xmlns:UserControl="clr-namespace:MachineVisionNodeEditor.Views.UserControls"
        xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
        xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
        WindowStyle="None"
        mc:Ignorable="d"
        Name="ImageImportWindow"
        Title="Image Import" d:Height="600" d:Width="800"
        d:DataContext="{d:DesignInstance Type=ViewModel:ImageImport_NodeViewModel}"
        KeyDown="ImageImportWindow_KeyDown">


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Resources/MainResource.xaml"></ResourceDictionary>-->
                <ResourceDictionary Source="/Resources/Styles/WindowStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"></ResourceDictionary>
                <!--<ResourceDictionary Source="/Resources/DataTemplates/ItemsControlDataTemplate.xaml"></ResourceDictionary>-->
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <UserControl:UserControl_ControlBar
            Grid.Row="0"
            Tag="{Binding ElementName=ImageImportWindow, Path=Title}">

        </UserControl:UserControl_ControlBar>

        <Canvas
            Grid.Row="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform
                            x:Name="scale"/>
                        <TranslateTransform
                            x:Name="translate"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Border
                    BorderThickness="1.5"
                    BorderBrush="DimGray"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">

                    <Canvas
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Width="{Binding NodePropertyModel.Width}"
                        Height="{Binding NodePropertyModel.Height}"
                        ClipToBounds="True">

                        <Canvas.Background>
                            <DrawingBrush 
                                TileMode="Tile"
                                Viewport="0,0,100,100"
                                ViewportUnits="Absolute">

                                <DrawingBrush.Drawing>
                                    <DrawingGroup>

                                        <!-- 🎨 MÀU NỀN -->
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,100,100"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- 🔲 GRID -->
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="{DynamicResource Grid}" Thickness="3">
                                                    <Pen.DashStyle>
                                                        <DashStyle Dashes="2.5"/>
                                                    </Pen.DashStyle>
                                                </Pen>
                                            </GeometryDrawing.Pen>

                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <!-- dọc -->
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                                                    <!-- ngang -->
                                                    <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                    </DrawingGroup>
                                </DrawingBrush.Drawing>

                            </DrawingBrush>
                        </Canvas.Background>

                        <Image
                            x:Name="Image"
                            Source="{Binding NodePropertyModel.Context.OutputImage,
                            Converter={StaticResource MatToBitmapSourceConverter}}"
                            Stretch="None"
                            RenderTransformOrigin="0,0"
                            MouseDown="Image_MouseDown"
                            MouseMove="Image_MouseMove"
                            MouseUp="Image_MouseUp"
                            MouseWheel="Image_MouseWheel">

                        </Image>

                    </Canvas>

                </Border>

            </Grid>


            <StackPanel
                Canvas.Bottom="5"
                Canvas.Right="5"
                Orientation="Horizontal">

                <Border
                    Margin="10 2"
                    Padding="5"
                    BorderThickness="2"
                    BorderBrush="DimGray"
                    CornerRadius="3">
                    <TextBlock
                        x:Name="TextBlock_PixelCoordinate"
                        Height="20"
                        FontSize="15">

                    </TextBlock>
                </Border>

                <Border
                    BorderThickness="2"
                    BorderBrush="DimGray"
                    Margin="10 2 "
                    Padding="5"
                    CornerRadius="3">
                    <TextBlock
                        Height="20"
                        FontSize="15"
                        Text="{Binding NodePropertyModel.FilePath, 
                        Converter={StaticResource ResolutionConverter},
                        ConverterParameter=Resolution}">

                    </TextBlock>
                </Border>


            </StackPanel>

        </Canvas>

    </Grid>

</Window>
