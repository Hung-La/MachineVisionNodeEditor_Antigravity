<local:NodeWindowControl 
        x:Class="MachineVisionNodeEditor.Views.Windows.NodeWindows.NodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.Windows.NodeWindows"
        xmlns:UserControl="clr-namespace:MachineVisionNodeEditor.Views.UserControls"
        xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
        xmlns:Viewer="clr-namespace:MachineVisionNodeEditor.Views.ImageViewer"
        xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
        WindowStyle="None"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ViewModel:ImageImport_NodeViewModel}"
        KeyDown="NodeWindowControl_KeyDown"
        x:Name="ImageWindow"
        Title="Result Image"
        Height="800" Width="1200">

    <local:NodeWindowControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Resources/MainResource.xaml"></ResourceDictionary>-->
                <ResourceDictionary Source="/Resources/Styles/WindowStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"></ResourceDictionary>
                <!--<ResourceDictionary Source="/Resources/DataTemplates/ItemsControlDataTemplate.xaml"></ResourceDictionary>-->
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </local:NodeWindowControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <UserControl:UserControl_ControlBar
            Grid.Row="0"
            Tag="{Binding ElementName=ImageWindow, Path=Title}">
        </UserControl:UserControl_ControlBar>


        <Canvas
            Grid.Row="1">

            <Viewer:ImageViewerControl
                ViewImage="{Binding NodePropertyModel.DestinationImage}">
            </Viewer:ImageViewerControl>

            <StatusBar
                Canvas.Right="5"
                Canvas.Bottom="5"
                VerticalAlignment="Bottom">

                <StackPanel
                  Orientation="Horizontal">

                    <Border
                        Margin="10 2"
                        Padding="5"
                        BorderThickness="2"
                        BorderBrush="DimGray"
                        CornerRadius="3">
                        <TextBlock
                            x:Name="TextBlock_PixelCoordinate"
                            Height="20"
                            FontSize="15">

                        </TextBlock>
                    </Border>

                    <Border
                        BorderThickness="2"
                        BorderBrush="DimGray"
                        Margin="10 2 "
                        Padding="5"
                        CornerRadius="3">
                        <TextBlock
                            Height="20"
                            FontSize="15"
                            Text="{Binding NodePropertyModel.DestinationImage, 
                            Converter={StaticResource ResolutionConverter},
                            ConverterParameter=Resolution}">

                        </TextBlock>
                    </Border>

                </StackPanel>

            </StatusBar>


        </Canvas>

    </Grid>
</local:NodeWindowControl>
