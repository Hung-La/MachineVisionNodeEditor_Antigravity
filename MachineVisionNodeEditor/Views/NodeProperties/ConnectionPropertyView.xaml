<local:NodePropertyControl x:Class="MachineVisionNodeEditor.Views.NodeProperties.ConnectionPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.NodeProperties"
             xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
             mc:Ignorable="d" 
             Background="{DynamicResource WindowBackground}"
             d:DataContext="{d:DesignInstance Type=ViewModel:Node_ConnectionViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <local:NodePropertyControl.Resources>
        <ResourceDictionary Source="/Resources/Styles/NodePropertyControlStyle.xaml"></ResourceDictionary>
    </local:NodePropertyControl.Resources>

    <StackPanel Margin="10">
        <!-- Header -->
        <TextBlock
        FontSize="18"
        FontWeight="Bold"
        Foreground="{DynamicResource Text}"
        Text="Connector"/>
        <Separator Margin="0 5"/>

        <GroupBox Header="General">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="From Node">
                    
                </TextBlock>

                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    IsEnabled="False"
                    Text="{Binding ConnectionModel.FromPort.Owner.Title}">
                    
                </TextBox>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="To Node">

                </TextBlock>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    IsEnabled="False"
                    Text="{Binding ConnectionModel.ToPort.Owner.Title}">
                    
                </TextBox>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Length">
                    
                </TextBlock>

                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    IsEnabled="False"
                    Text="{Binding ConnectionModel.Length, 
                            Mode=OneWay,
                            StringFormat=F2}">

                </TextBox>

            </Grid>
            
        </GroupBox>
        
    </StackPanel>
    
</local:NodePropertyControl>
