<local:NodePropertyControl 
             x:Class="MachineVisionNodeEditor.Views.NodeProperties.Canny_PropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.NodeProperties"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="{DynamicResource WindowBackground}"
             d:DesignHeight="600" d:DesignWidth="800">
    <local:NodePropertyControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/Styles/NodePropertyControlStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:NodePropertyControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
        <StackPanel>
            <!-- Header -->
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" Text="{Binding NodeModel.Title}"/>
            <Separator Margin="0 5"/>

            <!-- General GroupBox with Show Image button -->
            <GroupBox Header="General">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Name"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NodePropertyModel.Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NodePropertyModel.Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Button Grid.Column="1" Height="90" Command="{Binding ShowImageCommand}" CommandParameter="{Binding NodePropertyModel}" Margin="10 0">
                        <Button.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="DimGray"/>
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Row="0" Text="Show"/>
                                <TextBlock Grid.Row="1" Text="Image"/>
                            </Grid>
                        </Button.Content>
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0,1" StartPoint="1,0">
                                <GradientStop Color="LightYellow"/>
                                <GradientStop Color="LightGreen" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </GroupBox>

            <!-- Parameters -->
            <GroupBox Header="Canny Edge Settings" Margin="0,10,0,0">
                <StackPanel Margin="5">
                    <TextBlock Text="{Binding NodePropertyModel.Threshold1, StringFormat='Threshold 1 (Min): {0:F0}'}" Margin="0,4,0,4"/>
                    <Slider Minimum="0" Maximum="500" Value="{Binding NodePropertyModel.Threshold1}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding NodePropertyModel.Threshold2, StringFormat='Threshold 2 (Max): {0:F0}'}" Margin="0,4,0,4"/>
                    <Slider Minimum="0" Maximum="500" Value="{Binding NodePropertyModel.Threshold2}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                    <TextBlock Text="Aperture Size" Margin="0,4,0,4"/>
                    <ComboBox ItemsSource="{Binding NodePropertyModel.ApertureSizes}"
                              SelectedItem="{Binding NodePropertyModel.ApertureSize}"
                              Margin="0,0,0,12"/>

                    <CheckBox Content="Use L2 Gradient" IsChecked="{Binding NodePropertyModel.L2Gradient}" Margin="0,0,0,12"/>
                </StackPanel>
            </GroupBox>

            <!-- Input GroupBox -->
            <GroupBox Header="Input" Margin="0,10,0,0">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListView Grid.Column="0" Margin="5 5" ItemsSource="{Binding NodeModel.InputPorts}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="LightSteelBlue"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="MinWidth" Value="80"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Style>
                        </ListView.Resources>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FromPort.Owner.Title}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Name" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FromPort.Owner, Converter={StaticResource NodeViewModelConverter}, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="X Coordiate" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FromPort.Owner.X, StringFormat={}{0:F2}}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Y Coordiate" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FromPort.Owner.Y, StringFormat={}{0:F2}}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>

            <!-- Output GroupBox -->
            <GroupBox Header="Output" Margin="0,10,0,0">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListView Grid.Column="0" Margin="5 5" ItemsSource="{Binding NodeModel.OutputPorts}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="LightSteelBlue"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="MinWidth" Value="80"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Style>
                        </ListView.Resources>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ToPort.Owner.Title}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Name" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ToPort.Owner, Converter={StaticResource NodeViewModelConverter}, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="X Coordiate" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ToPort.Owner.X, StringFormat={}{0:F2}}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Y Coordiate" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortModel.Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ToPort.Owner.Y, StringFormat={}{0:F2}}" Foreground="{DynamicResource Text}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</local:NodePropertyControl>
