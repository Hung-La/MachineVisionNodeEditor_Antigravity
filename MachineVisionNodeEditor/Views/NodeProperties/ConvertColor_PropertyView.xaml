<local:NodePropertyControl x:Class="MachineVisionNodeEditor.Views.NodeProperties.ConvertColor_PropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MachineVisionNodeEditor.Views.NodeProperties"
             xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:ViewModel="clr-namespace:MachineVisionNodeEditor.ViewModels.NodeViewModels"
             mc:Ignorable="d" 
             Background="{DynamicResource WindowBackground}"
             d:DataContext="{d:DesignInstance Type=ViewModel:ConvertColor_NodeViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <local:NodePropertyControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ValueConverters/WindowValueConverter.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/Styles/NodePropertyControlStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </local:NodePropertyControl.Resources>

    <StackPanel>
        <!-- Header -->
        <TextBlock
            FontSize="18"
            FontWeight="Bold"
            Foreground="{DynamicResource Text}"
            Text="{Binding NodeModel.Title}"/>
        <Separator Margin="0 5"/>

        <!-- ====================== -->
        <!-- General -->
        <!-- ====================== -->

        <GroupBox Header="General">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="125"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="Name"/>
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        IsReadOnly="False"
                        Text="{Binding NodePropertyModel.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Description"/>
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        IsReadOnly="False"
                        Text="{Binding NodePropertyModel.Description, UpdateSourceTrigger=PropertyChanged}"/>


                </Grid>

                <Button
                    Grid.Column="1"
                    Height="90"
                    Command="{Binding ShowImageCommand}"
                    CommandParameter="{Binding NodePropertyModel}"
                    Margin="10 0">

                    <Button.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="18"></Setter>
                                    <Setter Property="FontWeight" Value="Bold"></Setter>
                                    <Setter Property="Foreground" Value="DimGray"></Setter>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Text="Show"></TextBlock>
                            <TextBlock Grid.Row="1" Text="Image"></TextBlock>

                        </Grid>

                    </Button.Content>

                    <Button.Background>
                        <LinearGradientBrush EndPoint="0,1" StartPoint="1,0">
                            <GradientStop Color="LightYellow"/>
                            <GradientStop Color="LightGreen" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>

        </GroupBox>

        <GroupBox Header="Color">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Color Mode">

                </TextBlock>

                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding NodePropertyModel.ColorCodes}"  
                    SelectedItem="{Binding NodePropertyModel.SelectedCode}"
                    Margin="20 5">

                </ComboBox>

            </Grid>
        </GroupBox>

        <GroupBox Header="Input">

            <Grid Margin="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ListView
                    Grid.Column="0"
                    Margin="5 5"
                    ItemsSource="{Binding NodeModel.InputPorts}">

                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="LightSteelBlue"></Setter>
                            <Setter Property="Foreground" Value="Black"></Setter>
                            <Setter Property="FontWeight" Value="Normal"></Setter>
                            <Setter Property="FontSize" Value="16"></Setter>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="5"></Setter>
                            <Setter Property="MinWidth" Value="80"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="FontWeight" Value="Normal"></Setter>
                            <Setter Property="FontSize" Value="16"></Setter>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"></Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding FromPort.Owner.Title}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Name" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding FromPort.Owner, 
                                                        Converter={StaticResource NodeViewModelConverter}, 
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--<GridViewColumn Header="View" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner.View}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>-->

                            <GridViewColumn Header="X Coordiate" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                                ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding FromPort.Owner.X, StringFormat={}{0:F2}}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Y Coordiate" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding FromPort.Owner.Y, StringFormat={}{0:F2}}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>

                </ListView>

            </Grid>

        </GroupBox>



        <GroupBox Header="Output">

            <Grid Margin="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ListView
                    Grid.Column="0"
                    Margin="5 5"
                    ItemsSource="{Binding NodeModel.OutputPorts}">

                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="LightSteelBlue"></Setter>
                            <Setter Property="Foreground" Value="Black"></Setter>
                            <Setter Property="FontWeight" Value="Normal"></Setter>
                            <Setter Property="FontSize" Value="16"></Setter>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="5"></Setter>
                            <Setter Property="MinWidth" Value="80"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="FontWeight" Value="Normal"></Setter>
                            <Setter Property="FontSize" Value="16"></Setter>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"></Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner.Title}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Name" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner, 
                                                        Converter={StaticResource NodeViewModelConverter}, 
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--<GridViewColumn Header="View" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner.View}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>-->

                            <GridViewColumn Header="X Coordiate" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                                ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner.X, StringFormat={}{0:F2}}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Y Coordiate" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl
                                            ItemsSource="{Binding PortModel.Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock 
                                                        Text="{Binding ToPort.Owner.Y, StringFormat={}{0:F2}}"
                                                        Foreground="{DynamicResource Text}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>

                </ListView>

            </Grid>

        </GroupBox>


        <!-- ====================== -->

    </StackPanel>
    
</local:NodePropertyControl>
